{
  "manifest_version": 3,
  "name": "Notas - Extensión simple",
  "version": "1.0",
  "description": "Una extensión para Microsoft Edge que permite crear, editar y eliminar notas rápidas.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": [
    "storage",
    "identity"
  ],
  "oauth2": {
    "client_id": "117696346057-u85v0pt7iie9op7hsnmd53deuepqs8c6.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/userinfo.email",
      "https://www.googleapis.com/auth/drive.appdata"
    ]
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}